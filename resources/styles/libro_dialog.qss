
/* ========================================
   LIBRO DIALOG - BIBLIOTECA DIGITAL
   ======================================== */

QDialog#LibroDialog {
    background-color: #FFFFFF;
}

/* Título principal */
QLabel#lblTitulo {
    color: #18392C;
    font-size: 22px;
    font-weight: 700;
    background: transparent;
}

/* Descripción */
QLabel#lblDescripcion {
    color: #718096;
    font-size: 13px;
    background: transparent;
}

/* Etiquetas de los campos */
QLabel#lblNombreLibro,
QLabel#lblAutor,
QLabel#lblISBN,
QLabel#lblCategoria {
    color: #334155;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

/* Campos de texto */
QLineEdit#txtTitulo,
QLineEdit#txtAutor,
QLineEdit#txtISBN {
    background-color: #F8FAFC;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 0px 12px;
    font-size: 13px;
    selection-background-color: #27845B;
}

QLineEdit#txtTitulo:focus,
QLineEdit#txtAutor:focus,
QLineEdit#txtISBN:focus {
    background-color: #FFFFFF;
    border: 2px solid #27845B;
}

/* Selector de categoría */
QComboBox#cmbCategoria {
    background-color: #F8FAFC;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 0px 12px;
    font-size: 13px;
}

QComboBox#cmbCategoria:focus {
    border: 2px solid #27845B;
    background-color: #FFFFFF;
}

QComboBox#cmbCategoria::drop-down {
    border: none;
    width: 28px;
}

QComboBox#cmbCategoria QAbstractItemView {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    selection-background-color: #E4F3EB;
    selection-color: #18392C;
    outline: none;
}

/* Botón cancelar */
QPushButton#btnCancelar {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#btnCancelar:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton#btnCancelar:pressed {
    background-color: #E2E8F0;
}

/* Botón guardar */
QPushButton#btnGuardar {
    background-color: #27845B;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#btnGuardar:hover {
    background-color: #206B4A;
}

QPushButton#btnGuardar:pressed {
    background-color: #18563B;
}

QPushButton#btnGuardar:disabled {
    background-color: #A7C9B7;
    color: #F1F5F9;
}
