
/* =====================================
   BIBLIOTECA DIGITAL - INICIO
   ===================================== */

/* 1. FONDO DE LA PANTALLA */

QWidget#InicioPage {
    background-color: #F3F5F3;
}

/* 2. ENCABEZADO */

QWidget#InicioPage QLabel#lblTitulo {
    color: #18392B;
    font-size: 26px;
    font-weight: bold;
}

QWidget#InicioPage QLabel#lblDescripcion {
    color: #718078;
    font-size: 13px;
    padding-bottom: 8px;
}

/* 3. TARJETAS DE ESTADÍSTICAS */

QFrame#cardLibros,
QFrame#cardEjemplares,
QFrame#cardLectores,
QFrame#cardPrestamos {
    background-color: #FFFFFF;
    border: 1px solid #E1E8E3;
    border-radius: 12px;
}

/* 4. ETIQUETAS DE LAS TARJETAS */

QLabel#lblCardLibros,
QLabel#lblCardEjemplares,
QLabel#lblCardLectores,
QLabel#lblCardPrestamos {
    color: #718078;
    font-size: 13px;
    font-weight: 500;
    border: none;
}

/* 5. VALORES DE LAS TARJETAS */

QLabel#lblTotalLibros,
QLabel#lblTotalEjemplares,
QLabel#lblTotalLectores,
QLabel#lblTotalPrestamos {
    color: #18392B;
    font-size: 30px;
    font-weight: bold;
    border: none;
}

/* 6. SUBTÍTULO */

QWidget#InicioPage QLabel#lblSubtitulo {
    color: #18392B;
    font-size: 17px;
    font-weight: bold;
}

/* 7. TABLA DE PRÉSTAMOS RECIENTES */

QTableWidget#tablaPrestamosRecientes {
    background-color: #FFFFFF;
    color: #243B2F;
    border: 1px solid #E1E8E3;
    border-radius: 8px;
    gridline-color: #EDF1EE;
    selection-background-color: #E5F1E9;
    selection-color: #18392B;
    font-size: 13px;
}

QTableWidget#tablaPrestamosRecientes QHeaderView::section {
    background-color: #F7F9F7;
    color: #53665A;
    border: none;
    border-bottom: 1px solid #E1E8E3;
    padding: 12px;
    font-size: 12px;
    font-weight: bold;
}

QTableWidget#tablaPrestamosRecientes::item {
    padding: 10px;
    border-bottom: 1px solid #EDF1EE;
}

QTableWidget#tablaPrestamosRecientes::item:hover {
    background-color: #F0F7F2;
}

/* 8. NOTA INFERIOR */

QWidget#InicioPage QLabel#lblNota {
    color: #718078;
    font-size: 12px;
}
